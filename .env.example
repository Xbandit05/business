# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PAWAPAY MOBILE MONEY INTEGRATION (Rwanda: MTN Mobile Money & Airtel Money)
# PAWAPAY_API_TOKEN: Bearer token from your PawaPay merchant dashboard (sandbox or live)
PAWAPAY_API_TOKEN=""
# PAWAPAY_ENVIRONMENT: "sandbox" or "live"
PAWAPAY_ENVIRONMENT="sandbox"
# PAWAPAY_BASE_URL: https://api.sandbox.pawapay.io (sandbox) or https://api.pawapay.io (live)
PAWAPAY_BASE_URL="https://api.sandbox.pawapay.io"
# PAWAPAY_CALLBACK_URL: Public webhook callback URL for payment status notifications
PAWAPAY_CALLBACK_URL=""
# AGRIBRIDGE_WEBHOOK_SECRET: Secret for HMAC signature verification on callbacks
AGRIBRIDGE_WEBHOOK_SECRET="agribridge_pawapay_secret_2026"
